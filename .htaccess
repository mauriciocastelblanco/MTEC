# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php71" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php71___lsphp .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

RewriteEngine On

# /servicios/:slug → /servicios/index.html (clean URL para fichas dinámicas)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^servicios/([^/]+)/?$ servicios/index.html [L]

# cleanUrls: si /foo no existe pero /foo.html sí, servir /foo.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Forzar HTTPS (descomentar DESPUÉS de activar AutoSSL en cPanel)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ── Performance: gzip compression on text responses ──────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/xml+rss image/svg+xml application/ld+json
</IfModule>

# ── Performance: long-lived cache for static assets ──────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"
  # HTML revalidates often (so content updates show up fast)
  ExpiresByType text/html                     "access plus 1 hour"
  # CSS/JS get hashed paths in a future revision; for now, 1 week
  ExpiresByType text/css                      "access plus 1 week"
  ExpiresByType application/javascript        "access plus 1 week"
  ExpiresByType application/json              "access plus 1 hour"
  # Images / fonts: cache aggressively (1 year)
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  # PDFs (fichas técnicas) — caché media
  ExpiresByType application/pdf               "access plus 1 month"
</IfModule>

# ── Security: minimal hardening ────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ── 404 fallback to home (opcional: descomentar si se quiere) ──
# ErrorDocument 404 /index.html
